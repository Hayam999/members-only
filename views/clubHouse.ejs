<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>The Hous Club 🏠</title>
  <link href="https://fonts.googleapis.com/css2?family=Boogaloo&family=Nunito:wght@400;600;800&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --yellow: #FFD93D;
      --orange: #FF6B35;
      --dark: #1a1a2e;
      --card: #16213e;
      --card-inner: #0f1729;
      --text: #eaeaea;
      --muted: #8892b0;
      --green: #06d6a0;
      --red: #ef233c;
      --purple: #a855f7;
    }

    body {
      min-height: 100vh;
      background: var(--dark);
      background-image:
        radial-gradient(ellipse at 20% 20%, rgba(255,107,53,0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, rgba(6,214,160,0.1) 0%, transparent 50%);
      font-family: 'Nunito', sans-serif;
      padding: 2rem;
      overflow-x: hidden;
    }

    .floating-emojis span {
      position: fixed;
      font-size: 2rem;
      animation: floatUp linear infinite;
      opacity: 0.08;
      pointer-events: none;
      user-select: none;
    }
    .floating-emojis span:nth-child(1) { left: 5%;  animation-duration: 9s;  animation-delay: 0s; }
    .floating-emojis span:nth-child(2) { left: 15%; animation-duration: 12s; animation-delay: 2s; }
    .floating-emojis span:nth-child(3) { left: 30%; animation-duration: 8s;  animation-delay: 1s; }
    .floating-emojis span:nth-child(4) { left: 50%; animation-duration: 11s; animation-delay: 3s; }
    .floating-emojis span:nth-child(5) { left: 70%; animation-duration: 10s; animation-delay: 0.5s; }
    .floating-emojis span:nth-child(6) { left: 85%; animation-duration: 7s;  animation-delay: 4s; }
    .floating-emojis span:nth-child(7) { left: 92%; animation-duration: 13s; animation-delay: 1.5s; }

    @keyframes floatUp {
      0%   { transform: translateY(110vh) rotate(0deg); opacity: 0; }
      10%  { opacity: 0.08; }
      90%  { opacity: 0.08; }
      100% { transform: translateY(-10vh) rotate(360deg); opacity: 0; }
    }

    /* ── LAYOUT ── */
    .page-wrapper {
      max-width: 780px;
      margin: 0 auto;
    }

    /* ── HEADER ── */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .header-left h1 {
      font-family: 'Boogaloo', cursive;
      font-size: 2.4rem;
      color: var(--yellow);
      line-height: 1;
    }

    .header-left p {
      color: var(--muted);
      font-size: 0.88rem;
      margin-top: 0.25rem;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 999px;
      padding: 0.4rem 1rem 0.4rem 0.5rem;
      font-size: 0.85rem;
      color: var(--text);
    }

    .user-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: var(--yellow);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Boogaloo', cursive;
      font-size: 1rem;
      font-weight: 700;
      flex-shrink: 0;
    }

    /* membership badge */
    .badge-pill {
      font-size: 0.7rem;
      font-weight: 800;
      padding: 2px 8px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-pill.user     { background: rgba(136,146,176,0.2); color: var(--muted); }
    .badge-pill.pro_user { background: rgba(168,85,247,0.2);  color: var(--purple); }
    .badge-pill.admin    { background: rgba(255,217,61,0.2);  color: var(--yellow); }

    .logout-btn {
      background: none;
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--muted);
      border-radius: 8px;
      padding: 0.35rem 0.75rem;
      font-size: 0.8rem;
      font-family: 'Nunito', sans-serif;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
      text-decoration: none;
      display: inline-block;
    }
    .logout-btn:hover { border-color: var(--red); color: var(--red); }

    /* ── COMPOSE BOX ── */
    .compose-card {
      background: var(--card);
      border: 2px solid rgba(255,217,61,0.2);
      border-radius: 20px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      box-shadow: 0 10px 40px rgba(0,0,0,0.3);
      animation: slideIn 0.5s cubic-bezier(0.16,1,0.3,1) both;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .compose-label {
      font-family: 'Boogaloo', cursive;
      font-size: 1.1rem;
      color: var(--yellow);
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .compose-card textarea {
      width: 100%;
      background: rgba(255,255,255,0.04);
      border: 2px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 0.85rem 1rem;
      font-size: 0.95rem;
      font-family: 'Nunito', sans-serif;
      color: var(--text);
      outline: none;
      resize: vertical;
      min-height: 90px;
      transition: border-color 0.2s, box-shadow 0.2s;
      line-height: 1.6;
    }

    .compose-card textarea:focus {
      border-color: var(--yellow);
      box-shadow: 0 0 0 4px rgba(255,217,61,0.08);
    }

    .compose-card textarea::placeholder { color: var(--muted); }

    .compose-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.75rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .char-count {
      font-size: 0.75rem;
      color: var(--muted);
      font-style: italic;
    }
    .char-count.warn  { color: var(--orange); }
    .char-count.limit { color: var(--red); }

    .send-btn {
      background: var(--yellow);
      color: var(--dark);
      border: none;
      border-radius: 10px;
      padding: 0.6rem 1.4rem;
      font-family: 'Boogaloo', cursive;
      font-size: 1.1rem;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
      box-shadow: 0 4px 14px rgba(255,217,61,0.3);
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .send-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255,217,61,0.4);
      background: #ffe566;
    }
    .send-btn:active { transform: translateY(0); }

    /* ── MESSAGES SECTION ── */
    .messages-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }

    .messages-title {
      font-family: 'Boogaloo', cursive;
      font-size: 1.3rem;
      color: var(--text);
    }

    .messages-count {
      font-size: 0.8rem;
      color: var(--muted);
      background: rgba(255,255,255,0.05);
      padding: 3px 10px;
      border-radius: 999px;
    }

    /* ── SINGLE MESSAGE CARD ── */
    .message-card {
      background: var(--card);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1rem;
      transition: border-color 0.2s, transform 0.2s;
      animation: msgIn 0.4s cubic-bezier(0.16,1,0.3,1) both;
      position: relative;
    }

    @keyframes msgIn {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .message-card:hover {
      border-color: rgba(255,217,61,0.15);
      transform: translateY(-1px);
    }

    .message-body {
      color: var(--text);
      font-size: 0.95rem;
      line-height: 1.7;
      margin-bottom: 0.75rem;
      word-break: break-word;
    }

    .message-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* Meta — only visible to pro_user / admin */
    .message-meta {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .meta-author {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .meta-avatar {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--purple);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.65rem;
      font-weight: 800;
      flex-shrink: 0;
    }

    .meta-author strong { color: var(--text); }

    .meta-date {
      font-size: 0.75rem;
      color: var(--muted);
      font-style: italic;
    }

    /* Anonymous label for regular users */
    .anon-label {
      font-size: 0.78rem;
      color: var(--muted);
      font-style: italic;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    /* Delete button — only for admin */
    .delete-form { margin: 0; }

    .delete-btn {
      background: none;
      border: 1px solid rgba(239,35,60,0.3);
      color: var(--red);
      border-radius: 8px;
      padding: 0.3rem 0.7rem;
      font-size: 0.75rem;
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .delete-btn:hover {
      background: rgba(239,35,60,0.1);
      border-color: var(--red);
    }

    /* ── EMPTY STATE ── */
    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      color: var(--muted);
    }
    .empty-state .empty-emoji { font-size: 3.5rem; display: block; margin-bottom: 1rem; }
    .empty-state h3 { font-family: 'Boogaloo', cursive; font-size: 1.4rem; color: var(--text); margin-bottom: 0.5rem; }
    .empty-state p { font-size: 0.88rem; }

    /* ── PRO UPGRADE BANNER ── */
    .upgrade-banner {
      background: rgba(168,85,247,0.08);
      border: 1px dashed rgba(168,85,247,0.35);
      border-radius: 14px;
      padding: 1rem 1.25rem;
      margin-bottom: 2rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .upgrade-banner p {
      font-size: 0.85rem;
      color: var(--muted);
      flex: 1;
    }
    .upgrade-banner p strong { color: var(--purple); }
    .upgrade-btn {
      background: var(--purple);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 0.45rem 1rem;
      font-family: 'Boogaloo', cursive;
      font-size: 1rem;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
      transition: opacity 0.2s;
    }
    .upgrade-btn:hover { opacity: 0.85; }

    /* ── FLASH ERROR ── */
    .flash-error {
      background: rgba(239,35,60,0.1);
      border: 1px solid rgba(239,35,60,0.3);
      color: var(--red);
      border-radius: 10px;
      padding: 0.75rem 1rem;
      margin-bottom: 1.5rem;
      font-size: 0.88rem;
    }

    @media (max-width: 520px) {
      body { padding: 1rem; }
      .header-left h1 { font-size: 1.8rem; }
      .message-card { padding: 1rem; }
    }
  </style>
</head>
<body>

  <div class="floating-emojis" aria-hidden="true">
    <span>💬</span><span>🏠</span><span>✨</span><span>🗣️</span>
    <span>💭</span><span>🎉</span><span>🔥</span>
  </div>

  <div class="page-wrapper">

    <!-- ── HEADER ── -->
    <div class="header">
      <div class="header-left">
        <h1>🏠 The Hous Club</h1>
        <p>Where people say things and others pretend to read them.</p>
      </div>

      <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
        <div class="user-pill">
          <div class="user-avatar">
            <%= user.first_name.charAt(0).toUpperCase() %>
          </div>
          <%= user.first_name %>
          <span class="badge-pill <%= membershipStatus %>">
            <%= membershipStatus === 'i\'m a pro-user' ? '⭐ Pro' : membershipStatus === 'i\'m an admin' ? '👑 Admin' : '🙂 Member' %>
          </span>
        </div>
        <a href="/logout" class="logout-btn">👋 Leave</a>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error">⚠️ <%= error %></div>
    <% } %>

    <!-- ── PRO UPGRADE BANNER (only for regular users) ── -->
    <% if (user.membership_status === 'user') { %>
      <div class="upgrade-banner">
        <p>
          👀 <strong>Upgrade to Pro</strong> to see who's actually talking —
          message authors and timestamps are currently a mystery to you. Spooky! 🕵️
        </p>
        <a href="/upgrade" class="upgrade-btn">✨ Go Pro</a>
      </div>
    <% } %>

    <!-- ── COMPOSE NEW MESSAGE ── -->
    <div class="compose-card">
      <div class="compose-label">💬 Drop a message</div>
      <form action="/club-house/messages" method="POST" id="composeForm">
        <textarea
          name="messageBody"
          id="messageBody"
          placeholder="Say something brilliant. Or just say something. We're not picky."
          maxlength="2000"
          required
        ></textarea>
        <div class="compose-footer">
          <span class="char-count" id="charCount">0 / 500</span>
          <button type="submit" class="send-btn">
            🚀 Send it
          </button>
        </div>
      </form>
    </div>

    <!-- ── MESSAGES LIST ── -->
    <div class="messages-header">
      <span class="messages-title">📋 The Board</span>
      <span class="messages-count">
        <%= messages.length %> <%= messages.length === 1 ? 'message' : 'messages' %>
      </span>
    </div>

    <% if (messages.length === 0) { %>
      <div class="empty-state">
        <span class="empty-emoji">🦗</span>
        <h3>Crickets. Literal crickets.</h3>
        <p>Nobody has said anything yet. Be the first brave soul.</p>
      </div>
    <% } else { %>

      <% messages.forEach(function(message, index) { %>
        <div class="message-card" style=`animation-delay: <%= index * 0.05 %>s`>

          <p class="message-body"><%= message.body %></p>

          <div class="message-footer">

            <!-- Meta: author + date — only for pro_user and admin -->
            <% if (user.membership_status === 'pro_user' || user.membership_status === 'admin') { %>
              <div class="message-meta">
                <div class="meta-author">
                  <div class="meta-avatar">
                    <%= message.author_first_name.charAt(0).toUpperCase() %>
                  </div>
                  <span>
                    <strong><%= message.author_first_name %> <%= message.author_last_name %></strong>
                  </span>
                </div>
                <span class="meta-date">
                  🕐 <%= new Date(message.created_at).toLocaleString('en-US', {
                    month: 'short', day: 'numeric', year: 'numeric',
                    hour: '2-digit', minute: '2-digit'
                  }) %>
                </span>
              </div>
            <% } else { %>
              <span class="anon-label">🕵️ Anonymous member</span>
            <% } %>

            <!-- Delete button — only for admin -->
            <% if (user.membership_status === 'admin') { %>
              <form class="delete-form" action="/messages/<%= message.id %>/delete" method="POST">
                <button type="submit" class="delete-btn"
                  onclick="return confirm('💀 Delete this message forever?')">
                  🗑️ Delete
                </button>
              </form>
            <% } %>

          </div>
        </div>
      <% }) %>

    <% } %>

  </div><!-- end page-wrapper -->

  <script>
    // Character counter for compose box
    const textarea  = document.getElementById('messageBody');
    const charCount = document.getElementById('charCount');
    const MAX = 500;

    textarea.addEventListener('input', () => {
      const len = textarea.value.length;
      charCount.textContent = `${len} / ${MAX}`;
      charCount.className = 'char-count';
      if (len >= MAX * 0.9) charCount.classList.add('limit');
      else if (len >= MAX * 0.75) charCount.classList.add('warn');
    });

    // Prevent empty submit
    document.getElementById('composeForm').addEventListener('submit', function(e) {
      if (!textarea.value.trim()) {
        e.preventDefault();
        textarea.style.borderColor = 'var(--red)';
        textarea.placeholder = 'Come on... type something! 😅';
        setTimeout(() => {
          textarea.style.borderColor = '';
          textarea.placeholder = 'Say something brilliant. Or just say something. We\'re not picky.';
        }, 2000);
      }
    });
  </script>

</body>
</html>