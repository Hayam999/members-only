<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Join The Hous Club 🔑</title>
  <link href="https://fonts.googleapis.com/css2?family=Boogaloo&family=Nunito:wght@400;600;800&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --yellow: #FFD93D;
      --orange: #FF6B35;
      --dark: #1a1a2e;
      --card: #16213e;
      --card-inner: #0f1729;
      --text: #eaeaea;
      --muted: #8892b0;
      --green: #06d6a0;
      --red: #ef233c;
      --purple: #a855f7;
    }

    body {
      min-height: 100vh;
      background: var(--dark);
      background-image:
        radial-gradient(ellipse at 20% 20%, rgba(255,107,53,0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 80%, rgba(6,214,160,0.1) 0%, transparent 50%);
      font-family: 'Nunito', sans-serif;
      padding: 2rem;
      overflow-x: hidden;
      display: flex;
      align-items: flex-start;
      justify-content: center;
    }

    .floating-emojis span {
      position: fixed;
      font-size: 2rem;
      animation: floatUp linear infinite;
      opacity: 0.08;
      pointer-events: none;
      user-select: none;
    }
    .floating-emojis span:nth-child(1) { left: 5%;  animation-duration: 9s;  animation-delay: 0s; }
    .floating-emojis span:nth-child(2) { left: 15%; animation-duration: 12s; animation-delay: 2s; }
    .floating-emojis span:nth-child(3) { left: 30%; animation-duration: 8s;  animation-delay: 1s; }
    .floating-emojis span:nth-child(4) { left: 50%; animation-duration: 11s; animation-delay: 3s; }
    .floating-emojis span:nth-child(5) { left: 70%; animation-duration: 10s; animation-delay: 0.5s; }
    .floating-emojis span:nth-child(6) { left: 85%; animation-duration: 7s;  animation-delay: 4s; }
    .floating-emojis span:nth-child(7) { left: 92%; animation-duration: 13s; animation-delay: 1.5s; }

    @keyframes floatUp {
      0%   { transform: translateY(110vh) rotate(0deg); opacity: 0; }
      10%  { opacity: 0.08; }
      90%  { opacity: 0.08; }
      100% { transform: translateY(-10vh) rotate(360deg); opacity: 0; }
    }

    /* ── LAYOUT ── */
    .page-wrapper {
      max-width: 560px;
      width: 100%;
      margin: 0 auto;
    }

    /* ── HEADER ── */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .header-left h1 {
      font-family: 'Boogaloo', cursive;
      font-size: 2.4rem;
      color: var(--yellow);
      line-height: 1;
    }

    .header-left p {
      color: var(--muted);
      font-size: 0.88rem;
      margin-top: 0.25rem;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 999px;
      padding: 0.4rem 1rem 0.4rem 0.5rem;
      font-size: 0.85rem;
      color: var(--text);
    }

    .user-avatar {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: var(--yellow);
      color: var(--dark);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Boogaloo', cursive;
      font-size: 1rem;
      font-weight: 700;
      flex-shrink: 0;
    }

    .badge-pill {
      font-size: 0.7rem;
      font-weight: 800;
      padding: 2px 8px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-pill.user     { background: rgba(136,146,176,0.2); color: var(--muted); }
    .badge-pill.pro_user { background: rgba(168,85,247,0.2);  color: var(--purple); }
    .badge-pill.admin    { background: rgba(255,217,61,0.2);  color: var(--yellow); }

    .logout-btn {
      background: none;
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--muted);
      border-radius: 8px;
      padding: 0.35rem 0.75rem;
      font-size: 0.8rem;
      font-family: 'Nunito', sans-serif;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
      text-decoration: none;
      display: inline-block;
    }
    .logout-btn:hover { border-color: var(--red); color: var(--red); }

    /* ── FLASH ERROR ── */
    .flash-error {
      background: rgba(239,35,60,0.1);
      border: 1px solid rgba(239,35,60,0.3);
      color: var(--red);
      border-radius: 10px;
      padding: 0.75rem 1rem;
      margin-bottom: 1.5rem;
      font-size: 0.88rem;
    }

    /* ── GATE CARD ── */
    .gate-card {
      background: var(--card);
      border: 2px solid rgba(255,217,61,0.2);
      border-radius: 20px;
      padding: 2.25rem 2rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 10px 40px rgba(0,0,0,0.3);
      animation: slideIn 0.5s cubic-bezier(0.16,1,0.3,1) both;
      text-align: center;
    }

    .gate-card.shake { animation: slideIn 0.5s cubic-bezier(0.16,1,0.3,1) both, shake 0.45s ease 0.5s; }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes shake {
      10%, 90% { transform: translateX(-2px); }
      20%, 80% { transform: translateX(4px); }
      30%, 50%, 70% { transform: translateX(-8px); }
      40%, 60% { transform: translateX(8px); }
    }

    .gate-icon {
      font-size: 3rem;
      display: block;
      margin-bottom: 0.75rem;
      animation: dangle 3s ease-in-out infinite;
      transform-origin: top center;
    }

    @keyframes dangle {
      0%, 100% { transform: rotate(-4deg); }
      50%      { transform: rotate(4deg); }
    }

    .gate-title {
      font-family: 'Boogaloo', cursive;
      font-size: 1.6rem;
      color: var(--yellow);
      margin-bottom: 0.4rem;
    }

    .gate-subtitle {
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 1.75rem;
      line-height: 1.5;
    }

    .code-input {
      width: 100%;
      background: rgba(255,255,255,0.04);
      border: 2px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 0.9rem 1rem;
      font-size: 1.1rem;
      font-family: 'Boogaloo', cursive;
      letter-spacing: 4px;
      text-align: center;
      text-transform: uppercase;
      color: var(--text);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .code-input:focus {
      border-color: var(--yellow);
      box-shadow: 0 0 0 4px rgba(255,217,61,0.08);
    }

    .code-input::placeholder {
      color: var(--muted);
      letter-spacing: normal;
      font-family: 'Nunito', sans-serif;
      text-transform: none;
      font-size: 0.9rem;
    }

    .join-btn {
      width: 100%;
      background: var(--yellow);
      color: var(--dark);
      border: none;
      border-radius: 10px;
      padding: 0.75rem 1.4rem;
      font-family: 'Boogaloo', cursive;
      font-size: 1.2rem;
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s, 0.15s;
      box-shadow: 0 4px 14px rgba(255,217,61,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1rem;
    }
    .join-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255,217,61,0.4);
      background: #ffe566;
    }
    .join-btn:active { transform: translateY(0); }

    .keys-hint {
      margin-top: 1.5rem;
      font-size: 0.78rem;
      color: var(--muted);
      font-style: italic;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }

    .gate-footer-note {
      text-align: center;
      color: var(--muted);
      font-size: 0.82rem;
      line-height: 1.6;
    }
    .gate-footer-note strong { color: var(--text); }

    @media (max-width: 520px) {
      body { padding: 1rem; }
      .header-left h1 { font-size: 1.8rem; }
      .gate-card { padding: 1.75rem 1.25rem; }
    }
  </style>
</head>
<body>

  <div class="floating-emojis" aria-hidden="true">
    <span>🔑</span><span>🔒</span><span>🚪</span><span>🏠</span>
    <span>✨</span><span>👑</span><span>🎉</span>
  </div>

  <div class="page-wrapper">

    <!-- ── HEADER ── -->
    <div class="header">
      <div class="header-left">
        <h1>🔑 Join The Hous Club</h1>
        <p>Members only past this point. No code, no couch.</p>
      </div>

      <% if (typeof user !== 'undefined' && user) { %>
        <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
          <div class="user-pill">
            <div class="user-avatar">
              <%= user.first_name.charAt(0).toUpperCase() %>
            </div>
            <%= user.first_name %>
            <span class="badge-pill <%= user.membership_status %>">
              <%= user.membership_status === 'pro_user' ? '⭐ Pro' : user.membership_status === 'admin' ? '👑 Admin' : '🙂 Member' %>
            </span>
          </div>
          <a href="/logout" class="logout-btn">👋 Leave</a>
        </div>
      <% } %>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash-error">❌ <%= error %></div>
    <% } %>

    <!-- ── SECRET CODE GATE ── -->
    <div class="gate-card <%= (typeof error !== 'undefined' && error) ? 'shake' : '' %>">
      <span class="gate-icon">🔒</span>
      <div class="gate-title">Got the secret code?</div>
      <p class="gate-subtitle">
        Somewhere out there, exactly three secret codes unlock the Club House.
        Type one in and see what happens.
      </p>

      <form action="/club-house" method="POST" id="joinForm">
        <input
          type="text"
          name="secretCode"
          id="secretCode"
          class="code-input"
          placeholder="Enter secret code..."
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          required
        />
        <button type="submit" class="join-btn">
          🚪 Join the Club
        </button>
      </form>

      <div class="keys-hint">🔑🔑🔑 <span>only 3 keys exist in the whole wide world</span></div>
    </div>

    <p class="gate-footer-note">
      Don't have a code? <strong>Ask someone who already got in.</strong>
      We're an HTML file — we can't make one up for you. 🤷
    </p>

  </div><!-- end page-wrapper -->

  <script>
    // Prevent empty submit + light UX polish
    const form  = document.getElementById('joinForm');
    const input = document.getElementById('secretCode');

    form.addEventListener('submit', function(e) {
      if (!input.value.trim()) {
        e.preventDefault();
        input.style.borderColor = 'var(--red)';
        input.placeholder = 'Come on, type something! 😅';
        setTimeout(() => {
          input.style.borderColor = '';
          input.placeholder = 'Enter secret code...';
        }, 2000);
      }
    });

    // Auto-focus the code field on load
    input.focus();
  </script>

</body>
</html>